{
  "name": "kyral-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "contracts:setup": "cd contracts && forge install foundry-rs/forge-std --no-git",
    "contracts:build": "cd contracts && forge build && cd .. && node scripts/gen-abi.mjs",
    "contracts:abi": "node scripts/gen-abi.mjs",
    "contracts:test": "cd contracts && forge test -vv",
    "contracts:deploy": "cd contracts && forge script script/Deploy.s.sol --rpc-url ${MONAD_RPC_URL:-https://testnet-rpc.monad.xyz} --broadcast",
    "seed:demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "test": "tsx --test \"server/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-wagmi": "^1.8.24",
    "@tanstack/react-query": "^5.104.1",
    "archiver": "^7.0.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "jsonwebtoken": "^9.0.3",
    "next": "16.1.6",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "viem": "^2.57.3",
    "wagmi": "^3.7.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^7.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
